# AI Universe Environment Configuration

# Service Settings
APP_NAME="AI-Universe"
APP_ENV="development"
API_HOST="127.0.0.1"
API_PORT=8000
API_KEY="" # Optional local auth key

# Database Settings
DATABASE_PATH="data/universe.db"

# LLM Providers (Cloud Inference)
GEMINI_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
MISTRAL_API_KEY=""
OPENROUTER_API_KEY=""

# Default Routing Settings
DEFAULT_PROVIDER="gemini"
DEFAULT_MODEL="gemini-2.5-flash"
DEFAULT_MODE="auto" # auto | fast | review | debate
MAX_DEBATE_AGENTS=5
ENABLE_EVALUATION=true
